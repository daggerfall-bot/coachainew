# ── App ──
ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1

# ── Database ──
DATABASE_URL=postgresql+asyncpg://coachai:coachai@localhost:5432/coachai

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Object storage (Cloudflare R2 example) ──
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=coachai-clips
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ── Vision: start on 'api', switch to 'self_hosted' once your model is trained ──
VISION_BACKEND=api
VISION_MODEL_PATH=models/ow2_state_detector.pt
VISION_SAMPLE_FPS=5

# ── LLM ──
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-20250514

# ── Video ──
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ── TTS (optional) ──
ELEVENLABS_API_KEY=

# ── Billing ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
